{
  "name": "worth-paypal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS=--max-old-space-size=1536 tsx server/index.ts",
    "build": "tsc -b && vite build && npm run build:merchant",
    "build:merchant": "vite build --config merchant/vite.config.ts",
    "start": "NODE_ENV=production NODE_OPTIONS=--max-old-space-size=${MAX_HEAP_MB:-384} tsx server/index.ts",
    "dev:merchant": "tsx merchant/server.ts",
    "dev:all": "npm run dev & npm run dev:merchant & wait",
    "start:merchant": "NODE_ENV=production tsx merchant/server.ts",
    "mcp:stdio": "node server/mcpStdio.ts",
    "typecheck": "tsc -b",
    "test": "vitest run --maxWorkers=1",
    "test:watch": "vitest --maxWorkers=1",
    "lint": "oxlint src server shared tests eval merchant",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "format": "prettier --write src server shared tests eval merchant *.ts *.json index.html",
    "format:check": "prettier --check src server shared tests eval merchant *.ts *.json index.html",
    "eval:live": "tsx eval/live.ts",
    "channel3:record": "tsx eval/channel3-record.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "papaparse": "^5.5.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.20.6",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.5",
    "@types/node": "^24.13.3",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "oxlint": "^1.81.0",
    "prettier": "^3.9.9",
    "supertest": "^7.1.4",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": "24.x"
  }
}
