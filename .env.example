# Worth environment. Copy to .env and fill in what you have; every key is optional locally.
# Without keys the engine still works: answers are labelled local calculations, checkout is a
# labelled simulation, and the similar-items panel is hidden. Never commit .env.

# --- Claude (Ask Worth, category suggestions) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Claude requests per client IP per hour and per server per day; past either, answers are local.
# CLAUDE_IP_HOURLY_LIMIT=20
# CLAUDE_DAILY_LIMIT=200

# --- PayPal (sandbox only; never use live credentials) ---
# A sandbox REST app on a US business account: https://developer.paypal.com/dashboard/
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# ID of the webhook registered for https://<host>/api/paypal/webhook. Needed to accept deliveries.
PAYPAL_WEBHOOK_ID=
# Sandbox decline demo (PayPal-Mock-Response on capture): on in development unless false,
# off in production unless true.
# PAYPAL_NEGATIVE_TESTING=true
# The payee PayPal's approval page and Activity name for Worth's own sandbox checkout.
# PAYPAL_BRAND_NAME=Sandbox demo merchant
# Connect PayPal: log in at PayPal and read activity through PayPal's MCP server (sandbox). On by
# default when PAYPAL_CLIENT_ID is set; off hides the button and the CSV import remains.
# PAYPAL_CONNECT=on
# Optional: a client registered on https://mcp.sandbox.paypal.com/register for
# <APP_ORIGIN>/api/paypal/connect/callback. Without it, Worth registers one at first use.
# PAYPAL_MCP_CLIENT_ID=

# --- Channel3 (similar items under "Spend less") ---
# Without a key the panel stays hidden.
CHANNEL3_API_KEY=
# live (default with a key), fixture (recorded example results, no credits) or off.
# CHANNEL3_MODE=live
# CHANNEL3_DAILY_LIMIT=300
# CHANNEL3_IP_HOURLY_LIMIT=20

# --- MCP (/mcp for outside agents) ---
# MCP_IP_PER_MINUTE=120
# MCP_TOKEN_PER_MINUTE=30

# --- Store hand-off (/check, "Analyse with Worth" on the demo store) ---
# Set both or neither: with neither the hand-off is off; production refuses only one of them. The key is shared
# with the store: 32+ random bytes, base64url, generated with
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# HANDOFF_SECRET=
# The demo store's origin, the only place a hand-off may send shoppers back to (https in production).
# MERCHANT_ORIGIN=http://localhost:8788
# HANDOFF_MERCHANT_ID=larkspur

# --- Server ---
PORT=5173
DATABASE_PATH=.runtime/worth.sqlite
# Public browser origin. Falls back to APP_URL, then RENDER_EXTERNAL_URL (set by Render), then
# http://localhost:$PORT. Production refuses to start on localhost or plain http.
# APP_ORIGIN=https://worth.example.com
# APP_URL=
# Defaults to 0.0.0.0 in production and 127.0.0.1 otherwise.
# HOST=
# Reverse-proxy hops trusted for the client IP: required in production (2 on Render), 0 locally.
# Check the X-Forwarded-For hop count logged on the first request after deploying.
# TRUST_PROXY=1
# production turns on the CSP, HSTS, the __Host- secure cookie and the HTTPS origin requirement.
# NODE_ENV=production

# --- Abuse limits (defaults shown) ---
# SESSION_IP_HOURLY_LIMIT=30
# MAX_SESSIONS=5000
# MAX_TRANSACTIONS=20000

# MAX_HEAP_MB (default 384) sets the Node heap for `npm start`. Set it in the shell or the host's
# environment: .env is read after Node has started.

# --- Larkspur Supply, the demo store (merchant/, its own origin) ---
# `npm run dev:merchant` serves it on MERCHANT_PORT (8788); `npm run dev:all` starts Worth too.
# It reads the PAYPAL_* keys above. In production PAYPAL_WEBHOOK_ID is the ID of the store's own
# webhook (https://<store host>/api/paypal/webhook), registered in the same sandbox app.
# MERCHANT_PORT=8788
# The store's public origin. Production: https only.
# MERCHANT_ORIGIN=http://localhost:8788
# Worth's public origin: the "Analyse with Worth" link and the report-back go here.
# Production example: https://worth.onrender.com
# WORTH_ORIGIN=http://localhost:5173
# The hand-off key shared by the store and Worth: 32+ random bytes, base64url. Generate with
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Required in production; without it locally the store uses a throwaway key Worth won't accept.
HANDOFF_SECRET=
HANDOFF_MERCHANT_ID=larkspur
