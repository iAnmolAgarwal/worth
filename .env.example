# Anthropic handles language; financial math is calculated locally.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Sandbox only. Never use live PayPal credentials in this prototype.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Sandbox decline demo (PayPal-Mock-Response on capture): on in development, opt-in in production.
# PAYPAL_NEGATIVE_TESTING=true

# Channel3 product search: "Similar items that fit today" under the Spend less option.
# Without a key the panel stays hidden. CHANNEL3_MODE=fixture shows the recorded example results
# without spending credits; off hides the panel.
CHANNEL3_API_KEY=
# CHANNEL3_MODE=live
# CHANNEL3_DAILY_LIMIT=300

PORT=5173
DATABASE_PATH=.runtime/worth.sqlite
# Public browser origin. Falls back to APP_URL, then RENDER_EXTERNAL_URL, then
# http://localhost:$PORT. Production refuses to start on localhost or plain http.
# APP_ORIGIN=https://worth.example.com
# Defaults to 0.0.0.0 in production and 127.0.0.1 otherwise.
# HOST=
# Reverse-proxy hops trusted for the client IP: 1 in production, 0 otherwise.
# Required in production: reverse proxies in front of the server (check the hop count logged on the first request).
# TRUST_PROXY=1

# Abuse limits (defaults shown).
# CLAUDE_IP_HOURLY_LIMIT=20
# CLAUDE_DAILY_LIMIT=200
# SESSION_IP_HOURLY_LIMIT=30
# MAX_SESSIONS=5000
# MAX_TRANSACTIONS=20000
